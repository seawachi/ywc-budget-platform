# ==========================================
# Camp & Club Budget Tracker — Environment Template
# ==========================================

# Supabase REST API & Storage
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Supabase S3-Compatible Storage Endpoint & Bucket
SUPABASE_S3_ENDPOINT="https://your-project-ref.supabase.co/storage/v1/s3"
SUPABASE_S3_REGION="ap-northeast-2"
SUPABASE_S3_BUCKET="receipts"
SUPABASE_S3_ACCESS_KEY_ID="your-s3-access-key-id"
SUPABASE_S3_SECRET_ACCESS_KEY="your-s3-secret-access-key"

# Database Connection Strings (PostgreSQL Pooler IPv4)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Google Gemini API Key for Receipt OCR
GEMINI_API_KEY="your-gemini-api-key"

# Better Auth Configuration
BETTER_AUTH_SECRET="your-better-auth-secret-key-min-32-chars"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Interactive Demo Mode
NEXT_PUBLIC_DEMO_MODE="true"
