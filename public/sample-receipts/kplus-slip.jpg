<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 420 650" width="100%" height="100%">
  <defs>
    <linearGradient id="kplus-grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#059669" />
      <stop offset="100%" stop-color="#047857" />
    </linearGradient>
    <filter id="slip-shadow">
      <feDropShadow dx="0" dy="6" stdDeviation="6" flood-opacity="0.12"/>
    </filter>
  </defs>

  <rect width="100%" height="100%" fill="#F8FAFC" />

  <!-- Slip Container -->
  <g filter="url(#slip-shadow)">
    <rect x="20" y="20" width="380" height="610" rx="16" fill="#FFFFFF" />
  </g>

  <!-- Top Banner -->
  <path d="M 20 36 C 20 27.16 27.16 20 36 20 L 384 20 C 392.84 20 400 27.16 400 36 L 400 110 L 20 110 Z" fill="url(#kplus-grad)" />
  <circle cx="60" cy="65" r="24" fill="#FFFFFF" opacity="0.2"/>
  <text x="60" y="73" font-family="sans-serif" font-weight="900" font-size="22" fill="#FFFFFF" text-anchor="middle">K+</text>
  <text x="95" y="60" font-family="sans-serif" font-weight="bold" font-size="18" fill="#FFFFFF">โอนเงินสำเร็จ</text>
  <text x="95" y="80" font-family="sans-serif" font-size="12" fill="#D1FAE5">25 ต.ค. 69 16:45 น. | เลขที่รายการ: 014298124982</text>

  <!-- Amount -->
  <rect x="40" y="130" width="340" height="75" rx="10" fill="#F0FDF4" stroke="#BBF7D0" />
  <text x="210" y="155" font-family="sans-serif" font-size="13" fill="#15803D" text-anchor="middle">จำนวนเงิน</text>
  <text x="210" y="190" font-family="sans-serif" font-size="28" font-weight="900" fill="#047857" text-anchor="middle">8,000.00 บาท</text>

  <!-- From Account -->
  <circle cx="55" cy="245" r="16" fill="#E2E8F0"/>
  <text x="55" y="250" font-family="sans-serif" font-weight="bold" font-size="12" fill="#475569" text-anchor="middle">จาก</text>
  <text x="85" y="242" font-family="sans-serif" font-size="14" font-weight="bold" fill="#0F172A">นายสมชาย หมายมั่น (Staff พัสดุ)</text>
  <text x="85" y="260" font-family="monospace" font-size="12" fill="#64748B">ธ.กสิกรไทย xxx-x-x1482-x</text>

  <line x1="85" y1="280" x2="380" y2="280" stroke="#E2E8F0" stroke-width="1"/>

  <!-- To Account -->
  <circle cx="55" cy="320" r="16" fill="#DCFCE7"/>
  <text x="55" y="325" font-family="sans-serif" font-weight="bold" font-size="12" fill="#16A34A" text-anchor="middle">ถึง</text>
  <text x="85" y="315" font-family="sans-serif" font-size="14" font-weight="bold" fill="#0F172A">บจก. สยามซาวด์ แอนด์ ไลท์ติ้ง</text>
  <text x="85" y="333" font-family="monospace" font-size="12" fill="#64748B">ธ.ไทยพาณิชย์ 408-x-xx912-8</text>

  <line x1="40" y1="365" x2="380" y2="365" stroke="#CBD5E1" stroke-dasharray="4 4" stroke-width="1.5"/>

  <!-- Details -->
  <text x="45" y="395" font-family="sans-serif" font-size="13" fill="#64748B">ค่าธรรมเนียม:</text>
  <text x="375" y="395" font-family="sans-serif" font-size="13" font-weight="bold" fill="#0F172A" text-anchor="end">0.00 บาท</text>

  <text x="45" y="425" font-family="sans-serif" font-size="13" fill="#64748B">บันทึกช่วยจำ:</text>
  <text x="375" y="425" font-family="sans-serif" font-size="13" font-weight="bold" fill="#0F172A" text-anchor="end">มัดจำเช่าระบบเสียง PA ค่ายวิศวะ</text>

  <!-- Verification QR Stamp -->
  <rect x="135" y="465" width="150" height="135" rx="8" fill="#F8FAFC" stroke="#E2E8F0" />
  <!-- Simulated QR Pattern -->
  <rect x="155" y="480" width="110" height="100" fill="#334155" rx="4"/>
  <rect x="163" y="488" width="30" height="30" fill="#FFFFFF"/>
  <rect x="170" y="495" width="16" height="16" fill="#334155"/>
  <rect x="227" y="488" width="30" height="30" fill="#FFFFFF"/>
  <rect x="234" y="495" width="16" height="16" fill="#334155"/>
  <rect x="163" y="542" width="30" height="30" fill="#FFFFFF"/>
  <rect x="170" y="549" width="16" height="16" fill="#334155"/>
  <text x="210" y="618" font-family="sans-serif" font-size="11" fill="#64748B" text-anchor="middle">สแกนเพื่อตรวจสอบสลิป</text>
</svg>
